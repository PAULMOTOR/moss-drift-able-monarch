# =============================================================================
# PAUL MOTOR CO. CRM — Environment variables for Vercel
# =============================================================================

# --- Required ---
DATABASE_URL=
BETTER_AUTH_URL=https://moss-drift-able-monarch.vercel.app
BETTER_AUTH_SECRET=

# --- Optional demo seed (set false once live) ---
CRM_SEED_DEMO=false
VITE_SHOW_DEMO_LOGINS=false

# --- Gmail auto-import (client@paulmotorcompany.com) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=client@paulmotorcompany.com

# Protects /api/cron/* (openssl rand -hex 24)
CRON_SECRET=

# --- Reminder / outbound emails (Resend) ---
RESEND_API_KEY=
CRM_FROM_EMAIL=client@paulmotorcompany.com

# Public links for lessee credit app & DocuSign return
APP_URL=https://moss-drift-able-monarch.vercel.app

# --- DocuSign eSignature + Live ID (JWT grant) ---
# From DocuSign Admin → Integrations → Apps and Keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# RSA private key PEM for JWT (paste full key; use \n for newlines in Vercel)
DOCUSIGN_RSA_PRIVATE_KEY=
# account.docusign.com (prod) or account-d.docusign.com (demo)
DOCUSIGN_AUTH_SERVER=account.docusign.com
# API base, e.g. https://na3.docusign.net or https://demo.docusign.net
DOCUSIGN_BASE_PATH=https://na3.docusign.net
# Optional — Identity Verification workflow ID for Live ID before signing
DOCUSIGN_IDV_WORKFLOW_ID=
