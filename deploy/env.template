# =============================================================================
# PAUL MOTOR CO. CRM — Environment variables for Vercel (and local prod-like)
# =============================================================================
# Copy values into Vercel → Project → Settings → Environment Variables.
# Do NOT commit a filled-in .env file with real secrets.
#
# Generate secrets with:
#   openssl rand -base64 32
# =============================================================================

# --- Required for production Postgres (Neon recommended) ---
# Neon dashboard → Project → Connection details → Pooled connection string
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Required Better Auth (sessions) ---
# Public HTTPS origin of this app (no trailing slash)
# Example: https://crm.paulmotorcompany.com  or  https://paul-motor-crm.vercel.app
BETTER_AUTH_URL=

# Long random secret used to sign session cookies (keep private)
BETTER_AUTH_SECRET=

# --- Email/password is already enabled in code (src/lib/auth/email-password.ts) ---
# Leave auth ON (do not set VITE_AUTH_ENABLED=false in production)
# VITE_AUTH_ENABLED=true

# --- Optional: seed demo team on first boot (prototype only) ---
# Production: leave unset or "false". Create real users in Admin instead.
# CRM_SEED_DEMO=false

# --- Optional: show demo login chips on /login (never in production) ---
# VITE_SHOW_DEMO_LOGINS=false

# --- Optional: Grok auth broker (Google / X) — injected by Grok deploy platform ---
# Only needed if you use "Continue with Google/X" in production outside Grok.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
