# Copy into the DMS lab Vercel project (Production env for branch dms).
# NEVER use production Neon or production Gmail tokens here.

DATABASE_URL=postgresql://...neon.../neondb?sslmode=require
BETTER_AUTH_SECRET=generate-a-new-secret
BETTER_AUTH_URL=https://YOUR-DMS-LAB.vercel.app
APP_URL=https://YOUR-DMS-LAB.vercel.app

APP_TRACK=dms
VITE_APP_TRACK=dms
LAB_DISABLE_SIDE_EFFECTS=true

CRM_SEED_DEMO=true
VITE_SHOW_DEMO_LOGINS=false

# Leave Gmail / Drive / Resend empty unless using sandbox accounts
# CRON_SECRET= optional — crons are empty on this branch
