# Copy to Vercel Environment Variables (do not commit real secrets).
# Full guide: deploy/VERCEL.md  ·  template: deploy/env.template

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
BETTER_AUTH_URL=https://your-app.vercel.app
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
CRM_SEED_DEMO=false
VITE_SHOW_DEMO_LOGINS=false
